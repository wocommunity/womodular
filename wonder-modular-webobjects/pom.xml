<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.wocommunity</groupId>
		<artifactId>womodular</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>wonder-modular-webobjects</artifactId>
	<dependencies>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-foundation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-eocontrol</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaWebObjects</artifactId>
			<exclusions>
				<exclusion>
					<groupId>com.webobjects</groupId>
					<artifactId>JavaXML</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>io.github.wocommunity</groupId>
			<artifactId>webobjects-patches</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>io.github.wocommunity:webobjcets-patches</include>
									<include>com.webobjects:JavaWebObjects</include>
								</includes>
							</artifactSet>
							<useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.moditect</groupId>
				<artifactId>moditect-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-module-info</id>
						<phase>package</phase>
						<goals>
							<goal>add-module-info</goal>
						</goals>
						<configuration>
							<jvmVersion>${womodules.jvm.version}</jvmVersion>
							<module>
								<moduleInfo>
									<name>org.wocommunity.webobjects.webobjects</name>
									<requires>
										java.logging;
										java.management;
										java.xml;
										org.wocommunity.webobjects.foundation;
										org.wocommunity.webobjects.eocontrol;
									</requires>
									<exports>
										com.webobjects._ideservices;
										com.webobjects.appserver;
										com.webobjects.appserver._private;
										com.webobjects.appserver.parser;
										com.webobjects.appserver.parser.declaration;
										com.webobjects.appserver.parser.woml;
										com.webobjects.appserver.parser.woml.namespaces;
										com.webobjects.appserver.xml;
										com.webobjects.appserver.xml._private;
									</exports>
								</moduleInfo>
							</module>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>