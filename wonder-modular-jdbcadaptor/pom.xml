<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.wocommunity</groupId>
		<artifactId>womodular</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>wonder-modular-jdbcadaptor</artifactId>
	<dependencies>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-foundation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-eocontrol</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-eoaccess</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>io.github.wocommunity</groupId>
			<artifactId>jdbcadaptor-patches</artifactId>
		</dependency>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaJDBCAdaptor</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>io.github.wocommunity:jdbcadaptor-patches</include>
									<include>com.webobjects:JavaJDBCAdaptor</include>
								</includes>
							</artifactSet>
							<useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.moditect</groupId>
				<artifactId>moditect-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-module-info</id>
						<phase>package</phase>
						<goals>
							<goal>add-module-info</goal>
						</goals>
						<configuration>
							<!-- I haven't figured out why I'm getting multi-release true in MANIFEST.MF -->
							<jdepsExtraArgs>
								<jdepsExtraArg>--multi-release=${womodules.jvm.version}</jdepsExtraArg>
								<jdepsExtraArg>--ignore-missing-deps</jdepsExtraArg>
							</jdepsExtraArgs>
							<jvmVersion>${womodules.jvm.version}</jvmVersion>
							<exclusions>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaFoundation</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>foundation-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>eocontrol-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaEOControl</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>eoaccess-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaEOAccess</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>jdbcadaptor-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaJDBCAdaptor</artifactId>
								</exclusion>
							</exclusions>
							<module>
								<moduleInfo>
									<name>org.wocommunity.webobjects.jdbcadaptor</name>
									<requires>
										org.wocommunity.webobjects.foundation;
										org.wocommunity.webobjects.eocontrol;
										org.wocommunity.webobjects.eoaccess;
									</requires>
									<exports>
										com.webobjects.jdbcadaptor;
									</exports>
								</moduleInfo>
							</module>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>