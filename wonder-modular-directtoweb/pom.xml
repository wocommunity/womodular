<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.wocommunity</groupId>
		<artifactId>womodular</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>wonder-modular-directtoweb</artifactId>
	<dependencies>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-foundation</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-eocontrol</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-eoaccess</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-webobjects</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-dtwgeneration</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.wocommunity</groupId>
			<artifactId>wonder-modular-eoproject</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>io.github.wocommunity</groupId>
			<artifactId>directtoweb-patches</artifactId>
		</dependency>
		<dependency>
			<groupId>com.webobjects</groupId>
			<artifactId>JavaDirectToWeb</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<artifactSet>
								<includes>
									<include>io.github.wocommunity:directtoweb-patches</include>
									<include>com.webobjects:JavaDirectToWeb</include>
								</includes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>KeyValueCodingProtectedAccessor.class</exclude>
									</excludes>
								</filter>
							</filters>
							<useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.moditect</groupId>
				<artifactId>moditect-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-module-info</id>
						<phase>package</phase>
						<goals>
							<goal>add-module-info</goal>
						</goals>
						<configuration>
							<jdepsExtraArgs>
								<jdepsExtraArg>--multi-release=${womodules.jvm.version}</jdepsExtraArg>
							</jdepsExtraArgs>
							<jvmVersion>${womodules.jvm.version}</jvmVersion>
							<module>
								<moduleInfo>
									<name>org.wocommunity.webobjects.directtoweb</name>
									<requires>
										java.desktop;
										org.wocommunity.webobjects.foundation;
										org.wocommunity.webobjects.eocontrol;
										org.wocommunity.webobjects.eoaccess;
										org.wocommunity.webobjects.webobjects;
										org.wocommunity.webobjects.dtwgeneration;
										org.wocommunity.webobjects.eoproject;
									</requires>
									<exports>
										com.webobjects.directtoweb;
										com.apple.client.directtoweb;
										com.apple.client.directtoweb.common;
										com.apple.client.directtoweb.mvc;
										com.apple.client.directtoweb.utils;
									</exports>
								</moduleInfo>
							</module>
							<exclusions>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaFoundation</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>foundation-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>eocontrol-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaEOControl</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaWebObjects</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>webobjects-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaEOAccess</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>eoaccess-patches</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaDTWGeneration</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaEOProject</artifactId>
								</exclusion>
								<exclusion>
									<groupId>com.webobjects</groupId>
									<artifactId>JavaDirectToWeb</artifactId>
								</exclusion>
								<exclusion>
									<groupId>io.github.wocommunity</groupId>
									<artifactId>directtoweb-patches</artifactId>
								</exclusion>
							</exclusions>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>